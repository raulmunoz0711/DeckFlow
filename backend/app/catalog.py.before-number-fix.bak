"""Strict TCGdex SQLite matching. Never confuse 018/159 with 018/160."""
from __future__ import annotations
import os,re,sqlite3
from pathlib import Path
from difflib import SequenceMatcher
DB=Path(os.getenv('DECKFLOW_CATALOG_DB','/app/data/pokemon_cards.sqlite3'))
def connect():
 DB.parent.mkdir(parents=True,exist_ok=True)
 db=sqlite3.connect(DB,timeout=15)
 db.execute('''CREATE TABLE IF NOT EXISTS cards (id TEXT PRIMARY KEY,language TEXT NOT NULL,name TEXT NOT NULL,local_id TEXT NOT NULL,card_number TEXT NOT NULL,set_id TEXT,set_name TEXT,image_url TEXT)''')
 db.execute('CREATE INDEX IF NOT EXISTS cards_local ON cards(local_id)')
 db.execute('CREATE INDEX IF NOT EXISTS cards_name ON cards(name COLLATE NOCASE)')
 return db
def count():
 with connect() as db:return db.execute('SELECT COUNT(*) FROM cards').fetchone()[0]
def norm_number(s):
 m=re.fullmatch(r'\s*0*(\d+)\s*/\s*0*(\d+)\s*',str(s))
 return (int(m[1]),int(m[2])) if m else None
def candidates(query:str,limit=6):
 q=query.strip()[:160]
 m=re.search(r'(?<!\d)(\d{1,4})\s*/\s*(\d{1,4})(?!\d)',q)
 want=norm_number(m.group(0)) if m else None
 name=re.sub(r'\d{1,4}\s*/\s*\d{1,4}',' ',q)
 name=re.sub(r'[^\w\- ]',' ',name).strip().lower()
 if not want and len(name)<3:return []
 with connect() as db:
  db.row_factory=sqlite3.Row
  if want:
   rows=db.execute('SELECT * FROM cards WHERE CAST(local_id AS INTEGER)=? LIMIT 15000',(want[0],)).fetchall()
  else:
   rows=db.execute('SELECT * FROM cards WHERE name LIKE ? COLLATE NOCASE LIMIT 3000',('%'+name+'%',)).fetchall()
 ranked=[]
 for r in rows:
  if want and norm_number(r['card_number'])!=want:continue
  nm=r['name'].lower()
  if name and name not in nm and nm not in name and SequenceMatcher(None,name,nm).ratio()<.82:continue
  score=(100 if want else 0)+(25 if name==nm else 10 if name and name in nm else 0)
  ranked.append((score,r))
 ranked.sort(key=lambda x:(-x[0],x[1]['name'],x[1]['set_name'] or ''))
 return [dict(card_name=r['name'],set_name=r['set_name'] or 'Unknown set',card_number=r['card_number'],variant='Local TCGdex catalog — confirm printing',tcgdex_id=r['id'],justtcg_id=None,image_url=r['image_url'],match_basis='number' if want else 'name',raw_market_price=0.0,graded_market_price=0.0) for _,r in ranked[:limit]]
