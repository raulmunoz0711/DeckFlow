"""Local TCGdex index for DeckFlow. Identification metadata, not condition grading."""
from __future__ import annotations
import os
import re
import sqlite3
from pathlib import Path
from difflib import SequenceMatcher

DB = Path(os.environ.get('DECKFLOW_CATALOG_DB', '/app/data/pokemon_cards.sqlite3'))


def connect():
    DB.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(str(DB), timeout=10)
    connection.execute('''CREATE TABLE IF NOT EXISTS cards (
       id TEXT PRIMARY KEY, language TEXT NOT NULL, name TEXT NOT NULL,
       local_id TEXT NOT NULL, card_number TEXT NOT NULL,
       set_id TEXT, set_name TEXT, image_url TEXT)''')
    connection.execute('CREATE INDEX IF NOT EXISTS cards_number ON cards(card_number)')
    connection.execute('CREATE INDEX IF NOT EXISTS cards_localid ON cards(local_id)')
    connection.execute('CREATE INDEX IF NOT EXISTS cards_name ON cards(name COLLATE NOCASE)')
    return connection


def count():
    with connect() as db:
        return db.execute('SELECT COUNT(*) FROM cards').fetchone()[0]


def norm_number(s):
    return re.sub(r'\b0+(\d)', r'\1', str(s).strip().lower())


# DECKFLOW_EXACT_MATCH_V2

def candidates(query: str, limit=6):
    """Match printed number exactly, never confuse 018/159 with 018/160."""
    query=query.strip()[:160]
    number=re.search(r'(?<!\d)(\d{1,4})\s*/\s*(\d{1,4})(?!\d)',query)
    clean_name=re.sub(r'\d{1,4}\s*/\s*\d{1,4}', ' ', query)
    clean_name=re.sub(r'[^\w -]', ' ', clean_name).strip().lower()
    with connect() as db:
        db.row_factory=sqlite3.Row
        if number:
            rows=db.execute('SELECT * FROM cards WHERE CAST(local_id AS INTEGER)=? LIMIT 2500',
                            (int(number.group(1)),)).fetchall()
        elif len(clean_name)>=3:
            rows=db.execute('SELECT * FROM cards WHERE name LIKE ? COLLATE NOCASE LIMIT 1200',
                            ('%' + clean_name + '%',)).fetchall()
        else:
            return []
    results=[]
    for r in rows:
        name=r['name'].lower()
        if clean_name and not (clean_name in name or name in clean_name or SequenceMatcher(None,clean_name,name).ratio() >= .84):
            continue
        if number:
            stored=re.fullmatch(r'(\d+)\s*/\s*(\d+)', r['card_number'] or '')
            if stored is None or (int(stored.group(1)),int(stored.group(2))) != (int(number.group(1)),int(number.group(2))):
                continue
        score=(100 if number else 0)+(25 if clean_name==name else 10 if clean_name and clean_name in name else 0)
        results.append((score,dict(r)))
    results.sort(key=lambda x:(-x[0],x[1]['name'],x[1]['set_name'] or ''))
    return [{'card_name':r['name'], 'set_name':r['set_name'] or 'Unknown set',
             'card_number':r['card_number'], 'variant':'TCGdex catalog match — confirm printing',
             'justtcg_id':None, 'tcgdex_id':r['id'], 'image_url':r['image_url'],
             'match_basis':'number' if number else 'name',
             'raw_market_price':0.0, 'graded_market_price':0.0} for _,r in results[:limit]]
